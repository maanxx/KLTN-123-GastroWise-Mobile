# ==============================================================================
# CẤU HÌNH API BACKEND CHO GASTROWISE MOBILE APP
# ==============================================================================

# Cách 1: Chạy Local Máy ảo Android Emulator (Default API)
EXPO_PUBLIC_API_URL=http://10.0.2.2:3001/api/v1

# Cách 2: Chạy trên Máy thật iPhone/Android (Điền địa chỉ IPv4 máy tính của bạn khi gõ `ipconfig`)
# EXPO_PUBLIC_API_URL=http://192.168.1.15:3001/api/v1

# Cách 3: Chạy môi trường Production (Hội đồng KLTN Test từ xa)
# EXPO_PUBLIC_API_URL=https://api-gastrowise.onrender.com/api/v1
